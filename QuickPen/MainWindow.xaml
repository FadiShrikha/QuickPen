<Window x:Class="QuickPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPen"
        mc:Ignorable="d"
        ResizeMode="NoResize" WindowState="Maximized" WindowStyle="None" Topmost="True" Background="Transparent" >
    
    <Window.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                
            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="ToggleButtonsStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" CornerRadius="10"   BorderThickness="1.6">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="#FF15600F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="EraserButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" Background="White" CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                            <Image Name="CheckImage" Width="30" Height="30" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Icons/icons8-eraser-64.png"/>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                                <Setter TargetName="CheckImage" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Canvas Name="MainCanvas">


        <Image  Name="Wallpaper"  Panel.ZIndex="0"/>
        <InkCanvas Name="DrawCanvas" Background="Transparent" Width="3000" Height="3000" Panel.ZIndex="1"/>

        <Border Height="150" Margin="0,250,0,0" Width="40" Panel.ZIndex="2"  BorderThickness="2" BorderBrush="AliceBlue" CornerRadius="5" Background="#FF062E03">
            <StackPanel Margin="0,-2,0,2">

                <ToggleButton Name="SelectColor" Click="SelectColor_Click"  Width="30" Height="30" Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-color-swatch-48.png" Margin="0,10,0,15">
                </ToggleButton>
                <ToggleButton  Name="UsePen" Click="UsePen_Click" Width="30" Height="30" Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-paintbrush-48.png" Margin="0,0,0,15" />
                <ToggleButton Name="UseEraser" MouseDoubleClick="UseEraser_MouseDoubleClick" Click="UseEraser_Click" Width="30"    Height="30" Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-eraser-64.png" Margin="0,0,0,15">
                    <Popup Name="EraserPop" AllowsTransparency="True" Placement="MousePoint" >
                        <StackPanel>
                            <ToggleButton Click="EraseByPoint_Click" IsChecked="True" Name="EraseByPoint" Style="{StaticResource EraserButtonStyle}" Tag="Erase by point">

                            </ToggleButton>
                            <ToggleButton Click="EraseByStroke_Click" IsChecked="False" Name="EraseByStroke" Style="{ StaticResource EraserButtonStyle}" Tag="Erase by Stroke"></ToggleButton>
                        </StackPanel>
                    </Popup>
                </ToggleButton>
            </StackPanel>
    </Border>
    </Canvas>
</Window>
