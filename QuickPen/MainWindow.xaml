<Window x:Class="QuickPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPen"
        xmlns:hm="http://schemas.hpod9.com/haley/wpf"
        mc:Ignorable="d"
        
        ResizeMode="NoResize"  WindowState="Maximized" Loaded="Window_Loaded" Background="Transparent"
        
        MouseWheel="Window_MouseWheel" KeyDown="Window_KeyDown" Closed="Window_Closed" PreviewMouseDown="Window_MouseDown" WindowStyle="None" Topmost="True" >
    
    <Window.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                
            </Style.Triggers>
        </Style>
        <Style TargetType="Border" x:Key="BorderRGBStyle">

        </Style>
        <Style TargetType="ToggleButton" x:Key="ToggleButtonsStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="#FF15600F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="EraserButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" Width="100" Height="40" Background="White" CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                            <Image Name="CheckImage" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Icons/icons8-check-50.png"/>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                                <Setter TargetName="CheckImage" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Canvas Name="MainCanvas">


        <Image  Name="Wallpaper"  Panel.ZIndex="0"/> 


        <InkCanvas Name="DrawCanvas" Background="Transparent" Panel.ZIndex="1"/>    
        
        <Border   Margin="0,250,0,0" Width="40" Panel.ZIndex="2"  BorderThickness="2" BorderBrush="AliceBlue" CornerRadius="5" Background="#FF062E03">
            <StackPanel Margin="0,-2,0,2">
                <Border Name="CurrentColorBorder" Background="{Binding _CurrentColor}" BorderBrush="#FF15600F" Margin="0,10,0,15" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6" />
                <ToggleButton Name="SelectColor" Click="Button_Click"   Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-color-picker-64.png" Margin="0,0,0,15">
                    <Popup Name="ChangeColorSliderPop" IsOpen="False" Width="300" Height="55" AllowsTransparency="True" Placement="MousePoint">
                        <Border Name="AllColorsBorder" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="Green" BorderBrush="Silver" BorderThickness="1.6" Height="40" Width="210"  >
                            <Canvas Width="200" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Name="RgbColorsImage" Source="/Icons/RGB_Allcolors.png" VerticalAlignment="Center" HorizontalAlignment="Center" Height="30" Width="200" Panel.ZIndex="0"/>

                                <Slider Name="AllColorsSlider" Maximum="198" BorderBrush="AliceBlue" BorderThickness="2"  
                                            Value="0" Height="30" Width="200" ValueChanged="Slider_ValueChanged" HorizontalAlignment="Center"  VerticalAlignment="Center"  />
                            </Canvas>
                        </Border>
                    </Popup>
                </ToggleButton>

                <ToggleButton  Name="UsePen" MouseDoubleClick="Btn_MouseDoubleClick" Click="Button_Click"  Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-paint-64.png" Margin="0,0,0,15" >
                    <Popup Name="BrushSizeSliderPopup" AllowsTransparency="True" Width="160" Placement="MousePoint" Height="33" IsOpen="False" PopupAnimation="Slide">
                        <Border CornerRadius="5" Background="Green" BorderBrush="Silver" BorderThickness="1.6" Height="25" Width="150"  Panel.ZIndex="4"  >

                            <Slider Name="BrushSizeSlider" Maximum="3" Value="0" 
                                ValueChanged="Slider_ValueChanged" Width="150" Height="25"  IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"  HorizontalAlignment="Center"     />

                         
                        </Border>
                    </Popup>
                </ToggleButton>
                <ToggleButton Name="UseEraser" MouseDoubleClick="Btn_MouseDoubleClick" Click="Button_Click" Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-eraser-24.png" Margin="0,0,0,15">
                    <Popup Name="EraserPop"  AllowsTransparency="True" Placement="MousePoint" IsOpen="False" PopupAnimation="Slide" >
                        <StackPanel>
                            <ToggleButton Click="Button_Click" IsChecked="False" Name="EraseByPoint" Style="{StaticResource EraserButtonStyle}" Tag="Erase by point">
                            </ToggleButton>
                            <ToggleButton Click="Button_Click" IsChecked="True" Name="EraseByStroke" Style="{ StaticResource EraserButtonStyle}" Tag="Erase by Stroke"></ToggleButton>
                        </StackPanel>
                    </Popup>
                </ToggleButton>
                <ToggleButton Name="Highlighter" Style="{StaticResource ToggleButtonsStyle}" IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-marker-pen-48.png" />
                <ToggleButton Name="SelectButton" Style="{StaticResource ToggleButtonsStyle}" IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-selection-60.png"/>
                <ToggleButton Name="ReBuildCanvas" Style="{StaticResource ToggleButtonsStyle}" IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-again-64.png"/>
            </StackPanel>
    </Border>
    </Canvas>
</Window>
