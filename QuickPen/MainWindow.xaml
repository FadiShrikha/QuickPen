<Window x:Class="QuickPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPen"
        xmlns:hm="http://schemas.hpod9.com/haley/wpf"
        mc:Ignorable="d"
        
        ResizeMode="NoResize" AllowsTransparency="True" WindowState="Maximized" Loaded="Window_Loaded"  Background="Transparent"
        
        MouseWheel="Window_MouseWheel"  Closed="Window_Closed" PreviewMouseDown="Window_MouseDown" WindowStyle="None" Topmost="True" >
    
    <Window.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter  Property="Background" Value="#6476FD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter  Property="Background" Value="Transparent"/>
                </Trigger>

            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="ToggleButtonsStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem" TargetType="ToggleButton">
                        <Border x:Name="buttonborder"  CornerRadius="10" Width="30" Height="30">
                            <Border.Background>
                                <SolidColorBrush x:Name="background" Color="#6476FD" Opacity="0"/>
                            </Border.Background>
                            <Image Opacity="0.5" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="background" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="background" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="#6476FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30">
                            <Border.Background>
                                <SolidColorBrush x:Name="background" Color="#6476FD" Opacity="0"/>
                            </Border.Background>
                            <Image Opacity="0.5" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="background" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="background" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Canvas Name="MainCanvas" AllowDrop="True" Drop="MainCanvasDrop"  >


        <Border  Name="Wallpaper" Background="#01000000" IsHitTestVisible="False"  Panel.ZIndex="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <InkCanvas Name="DrawCanvas"   Background="Transparent" Panel.ZIndex="1"/>
        
        <!--Colors-->
        <Popup Panel.ZIndex="2" Name="ColorsAndSizePopup" AllowsTransparency="True" IsOpen="False">
            
            <Border Name="ColorBorder" Width="200" Height="90" BorderThickness="0.2" CornerRadius="10" BorderBrush="White" Background="#1F2025">

                <StackPanel Orientation="Vertical" Width="190" VerticalAlignment="Top" Margin="0,5" HorizontalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Width="190" Height="30">
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="Black" Tag="ColorEllipse" Margin="0,0" Width="20" Height="20" MouseDown="Window_MouseDown" />
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="White" Tag="ColorEllipse" Margin="4,0" Width="20" Height="20" MouseDown="Window_MouseDown"/>
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="Red" Tag="ColorEllipse" Margin="4,0" Width="20" Height="20" MouseDown="Window_MouseDown"/>
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="Yellow" Tag="ColorEllipse" Margin="4,0" Width="20" Height="20" MouseDown="Window_MouseDown" />
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="Blue" Tag="ColorEllipse" Margin="4,0" Width="20" Height="20" MouseDown="Window_MouseDown"/>
                        <Ellipse Stroke="#616573" StrokeThickness="1" Fill="Green" Tag="ColorEllipse" Margin="4,0" Width="20" Height="20" MouseDown="Window_MouseDown" />
                        <Button Name="SelectColor" ToolTip="color slider" Click="ReDrawStroke_Click"  Style="{StaticResource  ButtonStyle}" Tag="/ModernIcons/icons8-color-picker-64.png">
                            <Popup Name="ChangeColorSliderPop" IsOpen="False" Width="300" Height="55" AllowsTransparency="True" Placement="MousePoint">

                                <Canvas Margin="4,0">
                                    <Image Name="RgbColorsImage" Source="/ModernIcons/RGB_Allcolors.png"/>

                                    <Slider Name="AllColorsSlider" Maximum="198" BorderBrush="AliceBlue" BorderThickness="2"  
                                    Value="70" Height="30" Width="200" ValueChanged="Slider_ValueChanged" HorizontalAlignment="Center"  VerticalAlignment="Center"  />
                                </Canvas>
                            </Popup>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Background="Transparent" Width="190">
                        <TextBlock Text="Size" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0" Foreground="#8E93A0"/>
                        <Slider Name="BrushSizeSlider" Maximum="30" Value="1" Opacity="0.5"
                                ValueChanged="Slider_ValueChanged" Width="150" IsSnapToTickEnabled="True"  
                                    VerticalAlignment="Center"  HorizontalAlignment="Center" TickPlacement="TopLeft" />

                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Border  x:Name="ItemsBorder" Canvas.Top="200" MouseMove="DragButton_MouseMove"   
                 Width="40" Panel.ZIndex="2"  BorderThickness="0.6" 
                BorderBrush="White"  CornerRadius="10" Background="#1F2025">
            <StackPanel>
                <!--Header-->
                <Border CornerRadius="10" Opacity="0.4" Width="30" Height="30" Style="{StaticResource BorderStyle}">
                    <Border.Background>
                        <ImageBrush ImageSource="/ModernIcons/grip-horizontal.png"/>
                    </Border.Background>
                </Border>
               <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" X1="30" Width="20" Height="1" Margin="0,10,0,20" />
                <!--UseMouse-->
                <ToggleButton Name="BackToCursor" ToolTip="use mouse" Style="{StaticResource  ToggleButtonsStyle}" Tag="/ModernIcons/pointer.png"
                              Margin="0,0,0,15" Click="Button_Click">
                   
                </ToggleButton>
                <!--UsePen-->
                <ToggleButton  Name="UsePen" ToolTip="pen"  Click="Button_Click" 
                               Style="{StaticResource ToggleButtonsStyle}" Tag="/ModernIcons/pencil.png" Margin="0,0,0,15"/>
                <!--UseHighlighter-->
                <ToggleButton Name="Highlighter" ToolTip="highlighter"  Style="{StaticResource ToggleButtonsStyle}" 
                              IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/ModernIcons/highlight.png" />

                <!--Eraser-->
                <ToggleButton Name="UseEraser" ToolTip="eraser" Click="Button_Click" 
                              Style="{StaticResource ToggleButtonsStyle}" Tag="/ModernIcons/eraser.png" Margin="0,0,0,15"/>

                <!--Select-->
                <ToggleButton Name="SelectButton" ToolTip="select" Style="{StaticResource ToggleButtonsStyle}" 
                               Margin="0,0,0,15" Click="Button_Click" Tag="/ModernIcons/marquee-2.png"/>
                <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" X1="30" Width="20" Height="1" Margin="0,0,0,20" />
                <!--Color-->
                <Button Name="CurrentColorButton" ToolTip="Pick color" Click="ReDrawStroke_Click"  Background="AliceBlue"
                        Margin="0,0,0,15"  Width="30" Height="30">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Setters>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Ellipse x:Name="cir" Stroke="White" StrokeThickness="2" Fill="{TemplateBinding Background}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="cir" Property="Stroke" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="False">
                                                    <Setter TargetName="cir" Property="Stroke" Value="#4C505C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style.Setters>
                        </Style>
                    </Button.Style>
                </Button>
                
                
                
                
                <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" X1="30" Width="20" Height="1" Margin="0,0,0,20" />
               
                <!--Undo-->
                <Button Name="UnDoLastStroke" ToolTip="Undo" Style="{StaticResource  ButtonStyle}" 
                        Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/ModernIcons/arrow-back-up.png"/>
                <!--Redo-->
                <Button Name="ReDrawStroke" ToolTip="undo" Style="{StaticResource  ButtonStyle}"  Margin="0,0,0,15"
                        Click="ReDrawStroke_Click" Tag="/ModernIcons/arrow-forward-up.png"/>
                <!--Rebuild-->
                <Button Name="ReBuildCanvas" ToolTip="clear" Style="{StaticResource  ButtonStyle}"
                        Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/ModernIcons/trash.png"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
