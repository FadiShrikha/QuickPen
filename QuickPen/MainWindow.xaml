<Window x:Class="QuickPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPen"
        xmlns:hm="http://schemas.hpod9.com/haley/wpf"
        mc:Ignorable="d"
        
        ResizeMode="NoResize" AllowsTransparency="True" WindowState="Maximized" Loaded="Window_Loaded"  Background="Transparent"
        
        MouseWheel="Window_MouseWheel"  Closed="Window_Closed" PreviewMouseDown="Window_MouseDown" WindowStyle="None" Topmost="True" >
    
    <Window.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter  Property="Background" Value="#6476FD"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter  Property="Background" Value="Transparent"/>
                </Trigger>

            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="ToggleButtonsStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="#6476FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="#6476FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="Button" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="#6476FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="EraserButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" Width="100" Height="40" Background="White" CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                            <Image Name="CheckImage" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Icons/icons8-check-50.png"/>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                                <Setter TargetName="CheckImage" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Canvas Name="MainCanvas" AllowDrop="True" Drop="MainCanvasDrop"  >


        <Border  Name="Wallpaper" Background="#01000000" IsHitTestVisible="False"  Panel.ZIndex="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <InkCanvas Name="DrawCanvas"   Background="Transparent" Panel.ZIndex="1"/>
        
        <Border  x:Name="ItemsBorder" Canvas.Top="200" MouseMove="DragButton_MouseMove"   
                 Width="40" Panel.ZIndex="2"  BorderThickness="0.6" 
                BorderBrush="White"  CornerRadius="10" Background="#1F2025">
            <StackPanel>
                <!--Header-->
                <Border CornerRadius="10" Width="30" Height="30" Style="{StaticResource BorderStyle}">
                    <Border.Background>
                        <ImageBrush ImageSource="/ModernIcons/grip-horizontal.png"/>
                    </Border.Background>
                </Border>
               <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" Width="20" Height="1" Margin="0,0,0,20" />
                <!--UseMouse-->
                <ToggleButton Name="BackToCursor" ToolTip="use mouse" Style="{StaticResource  ToggleButtonsStyle}" 
                              Margin="0,0,0,15" Click="Button_Click" Tag="/ModernIcons/pointer.png"/>
                <!--UsePen-->
                <ToggleButton  Name="UsePen" ToolTip="pen"  Click="Button_Click" 
                               Style="{StaticResource ToggleButtonsStyle}" Tag="/ModernIcons/pencil.png" Margin="0,0,0,15"/>
                <!--UseHighlighter-->
                <ToggleButton Name="Highlighter" ToolTip="highlighter"  Style="{StaticResource ToggleButtonsStyle}" 
                              IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/ModernIcons/highlight.png" />

                <!--Eraser-->
                <ToggleButton Name="UseEraser" ToolTip="eraser" MouseDoubleClick="Btn_MouseDoubleClick" Click="Button_Click" 
                              Style="{StaticResource ToggleButtonsStyle}" Tag="/ModernIcons/eraser.png" Margin="0,0,0,15"/>

                <!--Select-->
                <ToggleButton Name="SelectButton" ToolTip="select" Style="{StaticResource ToggleButtonsStyle}" 
                              IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/ModernIcons/marquee-2.png"/>
                <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" Width="20" Height="1" Margin="0,0,0,20" />
                <!--Color-->
                <Button Name="CurrentColorButton" ToolTip="current color" Click="Button_Click" Background="AliceBlue"
                        Margin="0,0,0,15"  Width="30" Height="30">
                    <Button.Style >
                        <Style TargetType="Button">
                            <Style.Setters>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CurentColorButtonBorder" Background="#6476FD" CornerRadius="10"></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CurentColorButtonBorder" Property="Background" Value="#6476FD"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="False">
                                                    <Setter TargetName="CurentColorButtonBorder" Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style.Setters>

                        </Style>
                    </Button.Style>
                </Button>
                
                
                
                
                <!--spaceline-->
                <Line Stroke="#616573" StrokeThickness="1" Fill="White" Width="20" Height="1" Margin="0,0,0,20" />
                
                <!--Undo-->
                <Button Name="UnDoLastStroke" ToolTip="Undo" Style="{StaticResource  ButtonStyle}" 
                        Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/ModernIcons/arrow-back-up.png"/>
                <!--Redo-->
                <Button Name="ReDrawStroke" ToolTip="undo" Style="{StaticResource  ButtonStyle}"  Margin="0,0,0,15"
                        Click="ReDrawStroke_Click" Tag="/ModernIcons/arrow-forward-up.png"/>
                <!--Rebuild-->
                <Button Name="ReBuildCanvas" ToolTip="clear" Style="{StaticResource  ButtonStyle}"
                        Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/ModernIcons/trash.png"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
