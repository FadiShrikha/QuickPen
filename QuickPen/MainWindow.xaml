<Window x:Class="QuickPen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickPen"
        xmlns:hm="http://schemas.hpod9.com/haley/wpf"
        mc:Ignorable="d"
        
        ResizeMode="NoResize" AllowsTransparency="True" WindowState="Maximized" Loaded="Window_Loaded"  Background="Transparent"
        
        MouseWheel="Window_MouseWheel"  Closed="Window_Closed" PreviewMouseDown="Window_MouseDown" WindowStyle="None" Topmost="True" >
    
    <Window.Resources>
        <Style TargetType="Border" x:Key="BorderStyle">

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>

            </Style.Triggers>
        </Style>
        <Style TargetType="ToggleButton" x:Key="ToggleButtonsStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="#FFFF1AD5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="Button" >
                        <Border x:Name="buttonborder" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="BorderBrush" Value="#FFFF1AD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" x:Key="EraserButtonStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate x:Name="ctrlTem"  TargetType="ToggleButton" >
                        <Border x:Name="buttonborder" Width="100" Height="40" Background="White" CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                            <Image Name="CheckImage" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Icons/icons8-check-50.png"/>
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter TargetName="buttonborder" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="buttonborder" Property="Background" Value="Silver"/>
                                <Setter TargetName="CheckImage" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    
    <Canvas Name="MainCanvas" AllowDrop="True" Drop="MainCanvasDrop"  >


        <Border  Name="Wallpaper" Background="#01000000" IsHitTestVisible="False"  Panel.ZIndex="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ElementName=BackToCursor,Path=IsChecked}" Value="False">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>


        <InkCanvas Name="DrawCanvas"   Background="Transparent" Panel.ZIndex="1"/>

        <Border x:Name="ItemsBorder" Canvas.Top="200"  
                 Width="40" Panel.ZIndex="2"  BorderThickness="3" 
                BorderBrush="#FF500000"  CornerRadius="5" Background="#FF080B52">
            <StackPanel Margin="0,-2,0,2">
                <Border Name="DragButton" ToolTip="drag" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6"
                        MouseMove="DragButton_MouseMove"   Margin="0,10,0,15">
                    <Border.Background>
                        <ImageBrush ImageSource="/Icons/icons8-drag-64.png"/>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="BorderBrush" Value="#FFFF1AD5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <ToggleButton Name="BackToCursor" ToolTip="use mouse" Style="{StaticResource  ToggleButtonsStyle}"  Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-cursor-64.png"/>
                <Border Name="CurrentColorBorder" ToolTip="current color" BorderBrush="#FFFF1AD5" Margin="0,0,0,15" CornerRadius="10" Width="30" Height="30"  BorderThickness="1.6" />
                <Button Name="SelectColor" ToolTip="color slider" Click="ReDrawStroke_Click"   Style="{StaticResource  ButtonStyle}" Tag="/Icons/icons8-color-picker-64.png" Margin="0,0,0,15">
                    <Popup Name="ChangeColorSliderPop" IsOpen="False" Width="300" Height="55" AllowsTransparency="True" Placement="MousePoint">

                        <Canvas Width="200" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image Name="RgbColorsImage" Source="/Icons/RGB_Allcolors.png" VerticalAlignment="Center" HorizontalAlignment="Center" Height="30" Width="200" Panel.ZIndex="0"/>

                            <Slider Name="AllColorsSlider" Maximum="198" BorderBrush="AliceBlue" BorderThickness="2"  
                                        Value="70" Height="30" Width="200" ValueChanged="Slider_ValueChanged" HorizontalAlignment="Center"  VerticalAlignment="Center"  />
                        </Canvas>
         
                    </Popup>
                </Button>

                <ToggleButton  Name="UsePen" ToolTip="pen" MouseDoubleClick="Btn_MouseDoubleClick" Click="Button_Click"  Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-paint-64.png" Margin="0,0,0,15" >
                    <Popup Name="BrushSizeSliderPopup" AllowsTransparency="True" Width="200" Placement="MousePoint" Height="40" IsOpen="False">
                        <Border CornerRadius="5" Background="#FF080B52" BorderBrush="#FF500000" BorderThickness="1.6" Height="40" Width="200" Panel.ZIndex="4"  >
                            <StackPanel Orientation="Horizontal" Width="200" Height="40">
                            <Slider Name="BrushSizeSlider" Maximum="30" Value="1" 
                                ValueChanged="Slider_ValueChanged" Width="150" Height="30"  IsSnapToTickEnabled="True"  
                                    VerticalAlignment="Center"  HorizontalAlignment="Center" TickPlacement="TopLeft"    />
                                <Ellipse StrokeThickness="1" Stroke="White" Margin="15,0,0,0"
                                    Width="{Binding ElementName=BrushSizeSlider , Path=Value}"
                                    Fill="{Binding ElementName=CurrentColorBorder,Path=Background}" Height="{Binding ElementName=BrushSizeSlider , Path=Value}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </ToggleButton>
                <ToggleButton Name="UseEraser" ToolTip="eraser" MouseDoubleClick="Btn_MouseDoubleClick" Click="Button_Click" Style="{StaticResource ToggleButtonsStyle}" Tag="/Icons/icons8-erase-64.png" Margin="0,0,0,15"/>
                <ToggleButton Name="Highlighter" ToolTip="highlighter" MouseDoubleClick="Btn_MouseDoubleClick" Style="{StaticResource ToggleButtonsStyle}" IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-marker-pen-48.png" />
                <ToggleButton Name="SelectButton" ToolTip="select" Style="{StaticResource ToggleButtonsStyle}" IsChecked="False" Margin="0,0,0,15" Click="Button_Click" Tag="/Icons/icons8-selection-60.png"/>
                <Button Name="ReDrawStroke" ToolTip="redo" Style="{StaticResource  ButtonStyle}"  Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/Icons/icons8-redo-64.png"/>
                <Button Name="UnDoLastStroke" ToolTip="undo" Style="{StaticResource  ButtonStyle}"  Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/Icons/icons8-undo-64.png"/>
                <Button Name="ReBuildCanvas" ToolTip="clear" Style="{StaticResource  ButtonStyle}" Margin="0,0,0,15" Click="ReDrawStroke_Click" Tag="/Icons/icons8-again-64.png"/>
            </StackPanel>
    </Border>
    </Canvas>
</Window>
